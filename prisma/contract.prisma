  // One person's own value for a display or language setting, or a
  // notification choice; outranks their workspace's and the platform's.
  model UserSetting {
    userId    String
    key       String
    value     Json
    updatedAt TimestampString(3) @default(now()) @onUpdate(now())
    user      User               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "UserSetting_userId_fkey")

    @@id([userId, key], map: "UserSetting_pkey")
  }

  model Member {
    id             String            @id(map: "Member_pkey") @onCreate(cuid(2))
    organizationId String
    userId         String
    role           String
    // "active" or "suspended": a suspended member keeps the seat but is granted nothing.
    status         String            @default("active")
    createdAt      TimestampString(3) @default(now())
    updatedAt      TimestampString(3) @default(now()) @onUpdate(now())
    tenant         Tenant            @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Member_organizationId_fkey")
    user           User              @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Member_userId_fkey")

    @@index([organizationId, userId], map: "Member_organizationId_userId_key", unique: true)
    @@index([userId], map: "Member_userId_idx")
  }

  model Invitation {
    id             String            @id(map: "Invitation_pkey") @onCreate(cuid(2))
    organizationId String
    email          String
    role           String
    status         String            @default("pending")
    teamId         String?
    inviterId      String
    expiresAt      TimestampString(3)
    createdAt      TimestampString(3) @default(now())
    updatedAt      TimestampString(3) @default(now()) @onUpdate(now())
    tenant         Tenant            @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Invitation_organizationId_fkey")
    inviter        User              @relation(fields: [inviterId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Invitation_inviterId_fkey")

    @@index([organizationId, email], map: "Invitation_organizationId_email_key", unique: true)
    @@index([email], map: "Invitation_email_idx")
  }

  // "Who changed this?" (spec/13-conventions.md, "Audit"; task 1.9). One row
  // per change, written by `audit()` in src/platform/audit: members, roles,
  // suspension, impersonation. tenantId is for filtering, not ownership —
  // platform-private, like ErrorReport, so a deleted tenant keeps its trail.
  model AuditLog {
    id         String             @id(map: "AuditLog_pkey") @onCreate(uuid(7))
    tenantId   String?
    actorId    String?
    // member | platform | customer | system
    actorKind  String
    // "<module>.<entity>.<verb>", e.g. "tenancy.member.role_changed"
    action     String
    targetType String?
    targetId   String?
    data       Json?
    reason     String?
    createdAt  TimestampString(3) @default(now())

    @@index([tenantId, createdAt], map: "AuditLog_tenantId_createdAt_idx")
  }

  // Custom permission groups ("nhóm quyền") written only through the plugin's
  // dynamicAccessControl API — never by hand (ADR 0019).
  model OrganizationRole {
    id             String            @id(map: "OrganizationRole_pkey") @onCreate(cuid(2))
    organizationId String
    role           String
    permission     Json
    createdAt      TimestampString(3) @default(now())
    updatedAt      TimestampString(3) @default(now()) @onUpdate(now())
    tenant         Tenant            @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "OrganizationRole_organizationId_fkey")

    @@index([organizationId, role], map: "OrganizationRole_organizationId_role_key", unique: true)
  }

  native_enum EmailStatus {
    QUEUED = "QUEUED"
    SENT = "SENT"
    REFUSED = "REFUSED"
    FAILED = "FAILED"
  }

  native_enum JobStatus {
    QUEUED = "QUEUED"
    RUNNING = "RUNNING"
    SUCCEEDED = "SUCCEEDED"
    FAILED = "FAILED"
  }

  native_enum TenantStatus {
    PROVISIONING = "PROVISIONING"
    ACTIVE = "ACTIVE"
    PAST_DUE = "PAST_DUE"
    SUSPENDED = "SUSPENDED"
    CANCELED = "CANCELED"
  }

  native_enum PlatformRole {
    OWNER = "OWNER"
    ADMIN = "ADMIN"
    SUPPORT = "SUPPORT"
    DESIGNER = "DESIGNER"
  }

  native_enum PlanVisibility {
    PUBLIC    = "PUBLIC"
    UNLISTED  = "UNLISTED"
    ARCHIVED  = "ARCHIVED"
  }

  native_enum BillingInterval {
    MONTH = "MONTH"
    YEAR = "YEAR"
    ONE_TIME = "ONE_TIME"
  }

  native_enum PurchaseStatus {
    COMPLETED = "COMPLETED"
    REFUNDED = "REFUNDED"
  }

  // USER < ADMIN < ROOT (spec/adr/0014-root-role.md). ROOT is granted only by
  // configuration (ROOT_EMAILS), never from the UI.
  native_enum Role {
    USER = "USER"
    ADMIN = "ADMIN"
    ROOT = "ROOT"
  }

  native_enum SubscriptionStatus {
    ACTIVE = "ACTIVE"
    PAST_DUE = "PAST_DUE"
    CANCELED = "CANCELED"
    UNPAID = "UNPAID"
    TRIALING = "TRIALING"
    INCOMPLETE = "INCOMPLETE"
  }
}

  // A tenant's public site (spec/03-domains.md, spec/09-data-model.md).
  // `tokens` and `sections` are validated against the theme's own schemas —
  // the contract stores them opaque.
  model Site {
    id          String             @id(map: "Site_pkey") @onCreate(cuid(2))
    tenantId    String
    themeKey    String             @default("main")
    tokens      Json?
    sections    Json?
    languages   Json               @default(json`["en"]`)
    status      SiteStatus         @default(DRAFT)
    publishedAt TimestampString(3)?
    createdAt   TimestampString(3) @default(now())
    updatedAt   TimestampString(3) @default(now()) @onUpdate(now())
    tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Site_tenantId_fkey")

    @@index([tenantId], map: "Site_tenantId_key", unique: true)
    @@rls
  }

  enum SiteStatus {
    DRAFT
    PUBLISHED
    MAINTENANCE
  }

  // The site's tenant-editable content (spec/06 "Content"): company profile,
  // opening hours and appearance — three JSON documents the theme reads.
  model SiteSettings {
    id         String             @id(map: "SiteSettings_pkey") @onCreate(cuid(2))
    tenantId   String
    profile    Json?
    hours      Json?
    appearance Json?
    createdAt  TimestampString(3) @default(now())
    updatedAt  TimestampString(3) @default(now()) @onUpdate(now())
    tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "SiteSettings_tenantId_fkey")

    @@index([tenantId], map: "SiteSettings_tenantId_key", unique: true)
    @@rls
  }

  // A tenant page keyed to a theme page key (spec/06: "Page keys come from
  // the theme manifest"). `content` is the theme-section JSON for that page.
  model Page {
    id        String             @id(map: "Page_pkey") @onCreate(cuid(2))
    tenantId  String
    key       String
    title     String?
    content   Json?
    sortOrder Int                @default(0)
    status    String             @default("published")
    createdAt TimestampString(3) @default(now())
    updatedAt TimestampString(3) @default(now()) @onUpdate(now())
    tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Page_tenantId_fkey")

    @@index([tenantId, key], map: "Page_tenantId_key_key", unique: true)
    @@rls
  }

  // An uploaded file in R2 (ADR 0018). `key` is the object key; the rules
  // (types, size) come from the platform `upload.*` settings (task 3.4).
  model Media {
    id          String             @id(map: "Media_pkey") @onCreate(cuid(2))
    tenantId    String
    key         String
    contentType String
    bytes       Int
    alt         String?
    width       Int?
    height      Int?
    createdAt   TimestampString(3) @default(now())
    tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Media_tenantId_fkey")

    @@index([tenantId, key], map: "Media_tenantId_key_key", unique: true)
    @@rls
  }

  // A custom domain a tenant attaches to its site (spec/03-domains.md).
  // `pending` until the provider's DNS check passes; `isPrimary` marks the
  // canonical hostname every other one redirects to.
  model Domain {
    id            String             @id(map: "Domain_pkey") @onCreate(cuid(2))
    tenantId      String
    hostname      String
    status        String             @default("pending")
    verification  Json?
    isPrimary     Boolean            @default(false)
    verifiedAt    TimestampString(3)?
    lastCheckedAt TimestampString(3)?
    createdAt     TimestampString(3) @default(now())
    updatedAt     TimestampString(3) @default(now()) @onUpdate(now())
    tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Domain_tenantId_fkey")

    @@index([hostname], map: "Domain_hostname_key", unique: true)
    @@index([tenantId], map: "Domain_tenantId_idx")
    @@rls
  }

  // The catalog module (spec/07): service categories, services with
  // duration and price, and per-service variants. `isSample` marks rows a
  // vertical wrote — removable in one click (spec/06).
  model ServiceCategory {
    id        String             @id(map: "ServiceCategory_pkey") @onCreate(cuid(2))
    tenantId  String
    name      String
    sortOrder Int                @default(0)
    createdAt TimestampString(3) @default(now())
    updatedAt TimestampString(3) @default(now()) @onUpdate(now())
    tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ServiceCategory_tenantId_fkey")
    services  Service[]

    @@index([tenantId], map: "ServiceCategory_tenantId_idx")
    @@rls
  }

  model Service {
    id              String           @id(map: "Service_pkey") @onCreate(cuid(2))
    tenantId        String
    categoryId      String?
    name            String
    description     String?
    durationMinutes Int              @default(60)
    priceCents      Int              @default(0)
    depositCents    Int?
    currency        String           @default("usd")
    imageKey        String?
    isSample        Boolean          @default(false)
    status          String           @default("active")
    createdAt       TimestampString(3) @default(now())
    updatedAt       TimestampString(3) @default(now()) @onUpdate(now())
    tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Service_tenantId_fkey")
    category        ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "Service_categoryId_fkey")
    variants        ServiceVariant[]
    staff           StaffService[]

    @@index([tenantId], map: "Service_tenantId_idx")
    @@rls
  }

  model ServiceVariant {
    id              String             @id(map: "ServiceVariant_pkey") @onCreate(cuid(2))
    tenantId        String
    serviceId       String
    name            String
    durationMinutes Int                @default(0)
    priceCents      Int                @default(0)
    createdAt       TimestampString(3) @default(now())
    updatedAt       TimestampString(3) @default(now()) @onUpdate(now())
    tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ServiceVariant_tenantId_fkey")
    service         Service            @relation(fields: [serviceId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ServiceVariant_serviceId_fkey")

    @@index([serviceId], map: "ServiceVariant_serviceId_idx")
    @@rls
  }

  // The team module (spec/07): staff shown on the site and used by booking.
  // A staff member is not a tenant member — it may never have a login.
  model StaffMember {
    id        String           @id(map: "StaffMember_pkey") @onCreate(cuid(2))
    tenantId  String
    name      String
    photo     String?
    bio       String?
    isSample  Boolean          @default(false)
    createdAt TimestampString(3) @default(now())
    updatedAt TimestampString(3) @default(now()) @onUpdate(now())
    tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "StaffMember_tenantId_fkey")
    services  StaffService[]

    @@index([tenantId], map: "StaffMember_tenantId_idx")
    @@rls
  }

  model StaffService {
    id            String      @id(map: "StaffService_pkey") @onCreate(cuid(2))
    tenantId      String
    staffMemberId String
    serviceId     String
    createdAt     TimestampString(3) @default(now())
    tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "StaffService_tenantId_fkey")
    staffMember   StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "StaffService_staffMemberId_fkey")
    service       Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "StaffService_serviceId_fkey")

    @@index([staffMemberId, serviceId], map: "StaffService_staffMemberId_serviceId_key", unique: true)
    @@rls
  }

  // The booking module (spec/07): resources (chair/room/station), weekly
  // availability rules, time-off, appointments and their status history.
  // All times are UTC instants; a `tsrange` exclusion constraint on staff
  // and on resource makes double booking impossible (decision 5-A).
  model Resource {
    id        String             @id(map: "Resource_pkey") @onCreate(cuid(2))
    tenantId  String
    name      String
    kind      String             @default("room")
    createdAt TimestampString(3) @default(now())
    updatedAt TimestampString(3) @default(now()) @onUpdate(now())
    tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Resource_tenantId_fkey")
    rules     AvailabilityRule[]
    timeOff   TimeOff[]
    appointments Appointment[]

    @@index([tenantId], map: "Resource_tenantId_idx")
    @@rls
  }

  model AvailabilityRule {
    id          String             @id(map: "AvailabilityRule_pkey") @onCreate(cuid(2))
    tenantId    String
    staffId     String?
    resourceId  String?
    weekday     Int
    startMinute Int
    endMinute   Int
    createdAt   TimestampString(3) @default(now())
    updatedAt   TimestampString(3) @default(now()) @onUpdate(now())
    tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "AvailabilityRule_tenantId_fkey")
    staff       StaffMember?       @relation(fields: [staffId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "AvailabilityRule_staffId_fkey")
    resource    Resource?          @relation(fields: [resourceId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "AvailabilityRule_resourceId_fkey")

    @@index([tenantId], map: "AvailabilityRule_tenantId_idx")
    @@rls
  }

  model TimeOff {
    id         String             @id(map: "TimeOff_pkey") @onCreate(cuid(2))
    tenantId   String
    staffId    String?
    resourceId String?
    startTs    TimestampString(3)
    endTs      TimestampString(3)
    reason     String?
    createdAt  TimestampString(3) @default(now())
    updatedAt  TimestampString(3) @default(now()) @onUpdate(now())
    tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "TimeOff_tenantId_fkey")
    staff      StaffMember?       @relation(fields: [staffId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "TimeOff_staffId_fkey")
    resource   Resource?          @relation(fields: [resourceId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "TimeOff_resourceId_fkey")

    @@index([tenantId], map: "TimeOff_tenantId_idx")
    @@rls
  }

  model Customer {
    id                     String             @id(map: "Customer_pkey") @onCreate(cuid(2))
    tenantId               String
    name                   String
    email                  String?
    phone                  String?
    language               String             @default("en")
    marketingConsentAt     TimestampString(3)?
    marketingConsentSource String?
    smsConsentAt           TimestampString(3)?
    smsConsentSource       String?
    createdAt              TimestampString(3) @default(now())
    updatedAt              TimestampString(3) @default(now()) @onUpdate(now())
    tenant                 Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Customer_tenantId_fkey")
    appointments           Appointment[]

    @@index([tenantId], map: "Customer_tenantId_idx")
    @@index([tenantId, email], map: "Customer_tenantId_email_idx")
    @@rls
  }

  model Appointment {
    id           String             @id(map: "Appointment_pkey") @onCreate(cuid(2))
    tenantId     String
    customerId   String
    serviceId    String?
    staffId      String
    resourceId   String?
    startTs      TimestampString(3)
    endTs        TimestampString(3)
    status       String             @default("requested")
    source       String             @default("site")
    notes        String?
    remindedAt   TimestampString(3)?
    createdAt    TimestampString(3) @default(now())
    updatedAt    TimestampString(3) @default(now()) @onUpdate(now())
    tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Appointment_tenantId_fkey")
    customer     Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Appointment_customerId_fkey")
    service      Service?           @relation(fields: [serviceId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "Appointment_serviceId_fkey")
    staff        StaffMember        @relation(fields: [staffId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Appointment_staffId_fkey")
    resource     Resource?          @relation(fields: [resourceId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "Appointment_resourceId_fkey")
    events       AppointmentEvent[]

    @@index([tenantId], map: "Appointment_tenantId_idx")
    @@index([staffId, startTs], map: "Appointment_staffId_startTs_idx")
    @@rls
  }

  model AppointmentEvent {
    id            String             @id(map: "AppointmentEvent_pkey") @onCreate(cuid(2))
    tenantId      String
    appointmentId String
    fromStatus    String?
    toStatus      String
    actor         String             @default("system")
    note          String?
    createdAt     TimestampString(3) @default(now())
    tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "AppointmentEvent_tenantId_fkey")
    appointment   Appointment        @relation(fields: [appointmentId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "AppointmentEvent_appointmentId_fkey")

    @@index([appointmentId], map: "AppointmentEvent_appointmentId_idx")
    @@rls
  }

  // The notifications module (spec/07): every outbound message logged with
  // its provider status — the audit trail of email and SMS sends.
  model NotificationLog {
    id         String             @id(map: "NotificationLog_pkey") @onCreate(cuid(2))
    tenantId   String
    channel    String
    template   String
    recipient  String
    status     String             @default("queued")
    providerId String?
    payload    Json?
    sentAt     TimestampString(3)?
    createdAt  TimestampString(3) @default(now())
    tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "NotificationLog_tenantId_fkey")

    @@index([tenantId], map: "NotificationLog_tenantId_idx")
    @@rls
  }

  // The reservations module (spec/07): a restaurant's tables, the service
  // periods and rules governing a slot, and the reservations themselves.
  // The unit is a party and a table, not a service and a staff member —
  // `availableSlots` is shared but `reservationSlots` adds party size and
  // turn time.
  model Table {
    id         String             @id(map: "Table_pkey") @onCreate(cuid(2))
    tenantId   String
    name       String
    capacity   Int
    area       String             @default("main")
    createdAt  TimestampString(3) @default(now())
    updatedAt  TimestampString(3) @default(now()) @onUpdate(now())
    tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Table_tenantId_fkey")
    reservations Reservation[]

    @@index([tenantId], map: "Table_tenantId_idx")
    @@rls
  }

  model ReservationRule {
    id              String             @id(map: "ReservationRule_pkey") @onCreate(cuid(2))
    tenantId        String
    weekday         Int
    startMinute     Int
    endMinute       Int
    slotMinutes     Int                @default(90)
    turnMinutes     Int                @default(15)
    minPartySize    Int                @default(1)
    maxPartySize    Int                @default(12)
    createdAt       TimestampString(3) @default(now())
    updatedAt       TimestampString(3) @default(now()) @onUpdate(now())
    tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ReservationRule_tenantId_fkey")

    @@index([tenantId], map: "ReservationRule_tenantId_idx")
    @@rls
  }

  model Reservation {
    id        String             @id(map: "Reservation_pkey") @onCreate(cuid(2))
    tenantId  String
    tableId   String?
    partySize Int
    startTs   TimestampString(3)
    endTs     TimestampString(3)
    name      String
    phone     String?
    email     String?
    status    String             @default("confirmed")
    notes     String?
    createdAt TimestampString(3) @default(now())
    updatedAt TimestampString(3) @default(now()) @onUpdate(now())
    tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Reservation_tenantId_fkey")
    table     Table?             @relation(fields: [tableId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "Reservation_tableId_fkey")

    @@index([tenantId], map: "Reservation_tenantId_idx")
    @@index([tableId, startTs], map: "Reservation_tableId_startTs_idx")
    @@rls
  }

  // Tenant payments (ADR 0006): a charge on the tenant's connected account
  // with our application fee. `kind` + the optional foreign ids link the
  // payment to its Appointment, Order or Quote; `checkoutSessionId` is the
  // idempotency key (one row per Stripe session).
  model Payment {
    id                 String             @id(map: "Payment_pkey") @onCreate(cuid(2))
    tenantId           String
    kind               String
    checkoutSessionId  String?            @unique(map: "Payment_checkoutSessionId_key")
    paymentIntentId    String?
    amountCents        Int
    feeCents           Int                @default(0)
    currency           String             @default("usd")
    status             String             @default("pending")
    customerId         String?
    appointmentId      String?
    orderId            String?
    quoteId            String?
    createdAt          TimestampString(3) @default(now())
    updatedAt          TimestampString(3) @default(now()) @onUpdate(now())
    tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Payment_tenantId_fkey")
    refunds            Refund[]

    @@index([tenantId], map: "Payment_tenantId_idx")
    @@rls
  }

  // A refund returns money to the customer and the application fee
  // proportionally (`feeRefundCents` — refundFee() in src/lib/billing/fee).
  model Refund {
    id             String             @id(map: "Refund_pkey") @onCreate(cuid(2))
    tenantId       String
    paymentId      String
    stripeRefundId String?
    amountCents    Int
    feeRefundCents Int                @default(0)
    status         String             @default("succeeded")
    createdAt      TimestampString(3) @default(now())
    tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Refund_tenantId_fkey")
    payment        Payment            @relation(fields: [paymentId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Refund_paymentId_fkey")

    @@index([tenantId], map: "Refund_tenantId_idx")
    @@index([paymentId], map: "Refund_paymentId_idx")
    @@rls
  }

  // The shop module (spec/07): products → anonymous cart → checkout on the
  // connected account → Order/OrderLine, pickup or shipping. A `Cart` is
  // keyed by a cookie until checkout attaches a Customer.
  model ProductCategory {
    id        String             @id(map: "ProductCategory_pkey") @onCreate(cuid(2))
    tenantId  String
    name      String
    position  Int                @default(0)
    createdAt TimestampString(3) @default(now())
    updatedAt TimestampString(3) @default(now()) @onUpdate(now())
    tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ProductCategory_tenantId_fkey")
    products  Product[]

    @@index([tenantId], map: "ProductCategory_tenantId_idx")
    @@rls
  }

  model Product {
    id          String             @id(map: "Product_pkey") @onCreate(cuid(2))
    tenantId    String
    categoryId  String?
    name        String
    type        String             @default("physical")
    description String?
    imageUrl    String?
    isActive    Boolean            @default(true)
    createdAt   TimestampString(3) @default(now())
    updatedAt   TimestampString(3) @default(now()) @onUpdate(now())
    tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Product_tenantId_fkey")
    category    ProductCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "Product_categoryId_fkey")
    variants    ProductVariant[]
    modifierGroups ProductModifierGroup[]

    @@index([tenantId], map: "Product_tenantId_idx")
    @@rls
  }

  model ProductVariant {
    id         String             @id(map: "ProductVariant_pkey") @onCreate(cuid(2))
    tenantId   String
    productId  String
    name       String
    priceCents Int
    sku        String?
    stockQty   Int?
    createdAt  TimestampString(3) @default(now())
    updatedAt  TimestampString(3) @default(now()) @onUpdate(now())
    tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ProductVariant_tenantId_fkey")
    product    Product            @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ProductVariant_productId_fkey")

    @@index([tenantId], map: "ProductVariant_tenantId_idx")
    @@index([productId], map: "ProductVariant_productId_idx")
    @@rls
  }

  model Cart {
    id         String             @id(map: "Cart_pkey") @onCreate(cuid(2))
    tenantId   String
    cartKey    String
    customerId String?
    createdAt  TimestampString(3) @default(now())
    updatedAt  TimestampString(3) @default(now()) @onUpdate(now())
    tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Cart_tenantId_fkey")
    lines      CartLine[]

    @@index([tenantId, cartKey], map: "Cart_tenantId_cartKey_idx")
    @@rls
  }

  model CartLine {
    id        String             @id(map: "CartLine_pkey") @onCreate(cuid(2))
    tenantId  String
    cartId    String
    variantId String
    quantity  Int                @default(1)
    createdAt TimestampString(3) @default(now())
    updatedAt TimestampString(3) @default(now()) @onUpdate(now())
    tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "CartLine_tenantId_fkey")
    cart      Cart               @relation(fields: [cartId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "CartLine_cartId_fkey")
    variant   ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "CartLine_variantId_fkey")

    @@index([tenantId], map: "CartLine_tenantId_idx")
    @@index([cartId], map: "CartLine_cartId_idx")
    @@rls
  }

  model Order {
    id           String             @id(map: "Order_pkey") @onCreate(cuid(2))
    tenantId     String
    customerId   String?
    customerName String
    customerEmail String?
    customerPhone String?
    totalCents   Int
    fulfilment   String             @default("pickup")
    pickupSlot   String?
    status       String             @default("received")
    createdAt    TimestampString(3) @default(now())
    updatedAt    TimestampString(3) @default(now()) @onUpdate(now())
    tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Order_tenantId_fkey")
    lines        OrderLine[]

    @@index([tenantId], map: "Order_tenantId_idx")
    @@rls
  }

  model OrderLine {
    id             String             @id(map: "OrderLine_pkey") @onCreate(cuid(2))
    tenantId       String
    orderId        String
    variantId      String?
    name           String
    quantity       Int                @default(1)
    unitPriceCents Int
    modifiers    Json                @default(json`[]`)
    createdAt      TimestampString(3) @default(now())
    tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "OrderLine_tenantId_fkey")
    order          Order             @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "OrderLine_orderId_fkey")

    @@index([tenantId], map: "OrderLine_tenantId_idx")
    @@index([orderId], map: "OrderLine_orderId_idx")
    @@rls
  }

  // The ordering module (spec/07): restaurant menu items carry modifier
  // groups — "size" or "toppings" — each option adding priceCents. The
  // OrderLine records chosen modifiers as JSON so totals stay what the
  // customer saw.
  model ProductModifierGroup {
    id            String             @id(map: "ProductModifierGroup_pkey") @onCreate(cuid(2))
    tenantId      String
    productId     String
    name          String
    minSelections Int                @default(0)
    maxSelections Int                @default(1)
    position      Int                @default(0)
    createdAt     TimestampString(3) @default(now())
    updatedAt     TimestampString(3) @default(now()) @onUpdate(now())
    tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ProductModifierGroup_tenantId_fkey")
    product       Product            @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ProductModifierGroup_productId_fkey")
    modifiers     ProductModifier[]

    @@index([tenantId], map: "ProductModifierGroup_tenantId_idx")
    @@index([productId], map: "ProductModifierGroup_productId_idx")
    @@rls
  }

  model ProductModifier {
    id           String             @id(map: "ProductModifier_pkey") @onCreate(cuid(2))
    tenantId     String
    groupId      String
    name         String
    priceCents   Int                @default(0)
    position     Int                @default(0)
    createdAt    TimestampString(3) @default(now())
    updatedAt    TimestampString(3) @default(now()) @onUpdate(now())
    tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ProductModifier_tenantId_fkey")
    group        ProductModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ProductModifier_groupId_fkey")

    @@index([tenantId], map: "ProductModifier_tenantId_idx")
    @@index([groupId], map: "ProductModifier_groupId_idx")
    @@rls
  }

  // The quotes module (spec/07): a customer fills the tenant's
  // schema-driven form → a `QuoteRequest`; the tenant prices it → a
  // `Quote` with lines, a validity window and a signed access token; the
  // customer accepts (and pays a deposit) → it converts to an order or
  // appointment. `QuoteEvent` records every transition.
  model QuoteRequest {
    id            String             @id(map: "QuoteRequest_pkey") @onCreate(cuid(2))
    tenantId      String
    customerName  String
    customerEmail String
    customerPhone String?
    answersJson   Json               @default(json`{}`)
    status        String             @default("new")
    createdAt     TimestampString(3) @default(now())
    updatedAt     TimestampString(3) @default(now()) @onUpdate(now())
    tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "QuoteRequest_tenantId_fkey")
    quotes        Quote[]

    @@index([tenantId], map: "QuoteRequest_tenantId_idx")
    @@rls
  }

  model Quote {
    id            String             @id(map: "Quote_pkey") @onCreate(cuid(2))
    tenantId      String
    requestId     String?
    customerName  String
    customerEmail String
    customerId    String?
    totalCents    Int                @default(0)
    depositCents  Int?
    currency      String             @default("usd")
    validUntil    TimestampString(3)?
    terms         String?
    status        String             @default("draft")
    accessToken   String             @unique(map: "Quote_accessToken_key")
    paymentId     String?
    createdAt     TimestampString(3) @default(now())
    updatedAt     TimestampString(3) @default(now()) @onUpdate(now())
    tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Quote_tenantId_fkey")
    request       QuoteRequest?      @relation(fields: [requestId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "Quote_requestId_fkey")
    lines         QuoteLine[]
    events        QuoteEvent[]

    @@index([tenantId], map: "Quote_tenantId_idx")
    @@rls
  }

  model QuoteLine {
    id             String             @id(map: "QuoteLine_pkey") @onCreate(cuid(2))
    tenantId       String
    quoteId        String
    name           String
    quantity       Int                @default(1)
    unitPriceCents Int
    createdAt      TimestampString(3) @default(now())
    tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "QuoteLine_tenantId_fkey")
    quote          Quote              @relation(fields: [quoteId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "QuoteLine_quoteId_fkey")

    @@index([tenantId], map: "QuoteLine_tenantId_idx")
    @@index([quoteId], map: "QuoteLine_quoteId_idx")
    @@rls
  }

  model QuoteEvent {
    id        String             @id(map: "QuoteEvent_pkey") @onCreate(cuid(2))
    tenantId  String
    quoteId   String
    kind      String
    dataJson  Json               @default(json`{}`)
    createdAt TimestampString(3) @default(now())
    tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "QuoteEvent_tenantId_fkey")
    quote     Quote              @relation(fields: [quoteId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "QuoteEvent_quoteId_fkey")

    @@index([tenantId], map: "QuoteEvent_tenantId_idx")
    @@index([quoteId], map: "QuoteEvent_quoteId_idx")
    @@rls
  }

  // The chatbot (ADR 0007): a tenant's knowledge base — sources (site
  // pages, FAQ entries, uploaded documents) chunked and embedded in
  // pgvector; `embeddingModel` tracks which model made each row so a model
  // change triggers a re-index. RLS applies like every tenant table.
  model KnowledgeSource {
    id             String             @id(map: "KnowledgeSource_pkey") @onCreate(cuid(2))
    tenantId       String
    type           String             @default("page")
    title          String
    status         String             @default("active")
    checksum       String
    embeddingModel String             @default("local")
    createdAt      TimestampString(3) @default(now())
    updatedAt      TimestampString(3) @default(now()) @onUpdate(now())
    tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "KnowledgeSource_tenantId_fkey")
    chunks         KnowledgeChunk[]

    @@index([tenantId], map: "KnowledgeSource_tenantId_idx")
    @@rls
  }

  model KnowledgeChunk {
    id          String             @id(map: "KnowledgeChunk_pkey") @onCreate(cuid(2))
    tenantId    String
    sourceId    String
    content     String
    language    String             @default("en")
    tokenCount  Int                @default(0)
    embedding   pgvector.Vector(length: 384)?
    createdAt   TimestampString(3) @default(now())
    updatedAt   TimestampString(3) @default(now()) @onUpdate(now())
    tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "KnowledgeChunk_tenantId_fkey")
    source      KnowledgeSource    @relation(fields: [sourceId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "KnowledgeChunk_sourceId_fkey")

    @@index([tenantId], map: "KnowledgeChunk_tenantId_idx")
    @@index([sourceId], map: "KnowledgeChunk_sourceId_idx")
    @@rls
  }

  // A visitor's conversation — the 90-day log the tenant reviews; personal
  // data minimised before quality review (spec/08).
  model ChatConversation {
    id            String             @id(map: "ChatConversation_pkey") @onCreate(cuid(2))
    tenantId      String
    visitorKey    String
    status        String             @default("active")
    createdAt     TimestampString(3) @default(now())
    updatedAt     TimestampString(3) @default(now()) @onUpdate(now())
    tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ChatConversation_tenantId_fkey")
    messages      ChatMessage[]

    @@index([tenantId], map: "ChatConversation_tenantId_idx")
    @@rls
  }

  model ChatMessage {
    id             String             @id(map: "ChatMessage_pkey") @onCreate(cuid(2))
    tenantId       String
    conversationId String
    role           String             @default("user")
    content        String
    sourcesJson    Json               @default(json`[]`)
    createdAt      TimestampString(3) @default(now())
    tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ChatMessage_tenantId_fkey")
    conversation   ChatConversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ChatMessage_conversationId_fkey")

    @@index([tenantId], map: "ChatMessage_tenantId_idx")
    @@index([conversationId], map: "ChatMessage_conversationId_idx")
    @@rls
  }