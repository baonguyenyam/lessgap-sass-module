// use prisma-8
// Contract inferred from the live database schema. Edit as needed, then run `prisma contract emit`.

namespace public {
  // ── kit ──
  model User {
    id                    String              @id(map: "User_pkey") @onCreate(cuid(2))
    name                  String
    email                 String
    image                 String?
    role                  pg.enum(Role)       @default("USER")
    // Platform staff only (spec/02-tenancy.md). Null for every tenant member.
    platformRole          pg.enum(PlatformRole)?
    stripeCustomerId      String?
    createdAt             TimestampString(3)  @default(now())
    updatedAt             TimestampString(3)  @onCreate(now()) @onUpdate(now())
onboardingDismissedAt TimestampString(3)?
    emailVerified         Boolean             @default(false)
    twoFactorEnabled      Boolean             @default(false)
    accounts              Account[]
    projects              Project[]
    sessions              Session[]
    twoFactors            TwoFactor[]
    members               Member[]
    invitations           Invitation[]
    settings              UserSetting[]

    @@index([email], map: "User_email_key", unique: true)
    @@index([stripeCustomerId], map: "User_stripeCustomerId_key", unique: true)
  }

  model Account {
    id                    String              @id(map: "Account_pkey") @onCreate(cuid(2))
    userId                String
    scope                 String?
    accountId             String
    providerId            String
    accessToken           String?
    refreshToken          String?
    accessTokenExpiresAt  TimestampString(3)?
    refreshTokenExpiresAt TimestampString(3)?
    idToken               String?
    password              String?
    createdAt             TimestampString(3)  @default(now())
    updatedAt             TimestampString(3)  @onCreate(now()) @onUpdate(now())
user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Account_userId_fkey")

    @@index([providerId, accountId], map: "Account_providerId_accountId_key", unique: true)
    @@index([userId], map: "Account_userId_idx")
  }

  model NewsletterSubscriber {
    id               String              @id(map: "NewsletterSubscriber_pkey") @onCreate(cuid(2))
    email            String
    source           String              @default("waitlist")
    createdAt        TimestampString(3)  @default(now())
    confirmedAt      TimestampString(3)?
    confirmToken     String
    unsubscribeToken String
    unsubscribedAt   TimestampString(3)?
    // The workspace whose list this is; null for the platform's own list.
    tenantId         String?
    tenant           Tenant?             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "NewsletterSubscriber_tenantId_fkey")

    @@index([confirmToken], map: "NewsletterSubscriber_confirmToken_key", unique: true)
    @@index([tenantId, email], map: "NewsletterSubscriber_tenantId_email_key", unique: true)
    @@index([unsubscribeToken], map: "NewsletterSubscriber_unsubscribeToken_key", unique: true)
    @@rls
  }

  // Daily domain reconciliation (task 8.2): one row per drift found by
  // the `platform.domain.reconcile` job — a Domain row the provider lacks
  // ("missing_provider") or a provider hostname no row claims
  // ("extra_provider"). Platform-private: the latest run is the report.
  model DomainCheck {
    id        String             @id(map: "DomainCheck_pkey") @onCreate(cuid(2))
    runId     String
    hostname  String
    kind      String
    tenantId  String?
    createdAt TimestampString(3) @default(now())

    @@index([runId], map: "DomainCheck_runId_idx")
  }

  // Kit Plan, extended with entitlements (spec/09-data-model.md, phase 2).
  // `features` is the entitlement map the resolver reads — { [FeatureKey]:
  // boolean | number | null } validated against the feature registry.
  // `marketingFeatures` is the bullet list the pricing page shows.
  model Plan {
    id             String                   @id(map: "Plan_pkey") @onCreate(cuid(2))
    name           String
    slug           String
    description    String?
    price          Int
    interval       pg.enum(BillingInterval)
    stripePriceId  String?
    marketingFeatures String[]             @default([])
    features       Json                     @default(json`{}`)
    visibility     pg.enum(PlanVisibility)  @default("PUBLIC")
    setupFeeCents  Int?
    feeModel       Json?
    isActive       Boolean                  @default(true)
    createdAt      TimestampString(3)       @default(now())
    updatedAt      TimestampString(3)  @onCreate(now()) @onUpdate(now())
meterEventName String?
    trialDays      Int?
    gracePeriodDays Int?
    purchases      Purchase[]
    subscriptions  Subscription[]

    @@index([slug], map: "Plan_slug_key", unique: true)
    @@index([stripePriceId], map: "Plan_stripePriceId_key", unique: true)
  }

  model Project {
    id          String             @id(map: "Project_pkey") @onCreate(cuid(2))
    name        String
    description String?
    userId      String
    createdAt   TimestampString(3) @default(now())
    updatedAt   TimestampString(3)  @onCreate(now()) @onUpdate(now())
user        User               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Project_userId_fkey")

    @@index([userId], map: "Project_userId_idx")
  }

  model Purchase {
    id                      String                  @id(map: "Purchase_pkey") @onCreate(cuid(2))
    tenantId                String
    planId                  String?
    addOnId                 String?
    stripePaymentIntentId   String
    stripeCheckoutSessionId String?
    amount                  Int
    currency                String                  @default("usd")
    status                  pg.enum(PurchaseStatus) @default("COMPLETED")
    createdAt               TimestampString(3)      @default(now())
    updatedAt               TimestampString(3)  @onCreate(now()) @onUpdate(now())
plan                    Plan?                   @relation(fields: [planId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "Purchase_planId_fkey", index: false)
    addOn                   AddOn?                  @relation(fields: [addOnId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "Purchase_addOnId_fkey", index: false)
    tenant                  Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Purchase_tenantId_fkey")

    @@index([stripeCheckoutSessionId], map: "Purchase_stripeCheckoutSessionId_key", unique: true)
    @@index([stripePaymentIntentId], map: "Purchase_stripePaymentIntentId_key", unique: true)
    @@index([tenantId], map: "Purchase_tenantId_idx")
    @@rls
  }

  model Session {
    id        String             @id(map: "Session_pkey") @onCreate(cuid(2))
    token     String
    userId    String
    expiresAt TimestampString(3)
    ipAddress String?
    userAgent String?
    // Set on a Switch As session: the ROOT user who opened it (spec/adr/0015-switch-as.md).
    switchedBy String?
    // Set on a tenant-impersonation session (task 1.11), alongside switchedBy:
    // the tenant being viewed and the staff-written reason, so the banner and
    // every mutation's audit row can show it until the session ends.
    impersonationTenantId String?
    impersonationReason String?
    // The tenant this session is working in, set by Better Auth's organization
    // plugin (setActive). It writes the column through Kysely on every new session.
    activeOrganizationId String?
    createdAt TimestampString(3) @default(now())
    updatedAt TimestampString(3)  @onCreate(now()) @onUpdate(now())
user      User               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Session_userId_fkey")

    @@index([token], map: "Session_token_key", unique: true)
    @@index([userId], map: "Session_userId_idx")
  }

  // Kit Subscription, re-owned (spec/09-data-model.md): `tenantId String
  // @unique` replaces `userId` — one subscription per tenant.
  model Subscription {
    id                   String                      @id(map: "Subscription_pkey") @onCreate(cuid(2))
    tenantId             String
    planId               String
    stripeSubscriptionId String?
    status               pg.enum(SubscriptionStatus)
    currentPeriodStart   TimestampString(3)
    currentPeriodEnd     TimestampString(3)
    cancelAtPeriodEnd    Boolean                     @default(false)
    createdAt            TimestampString(3)          @default(now())
    updatedAt            TimestampString(3)  @onCreate(now()) @onUpdate(now())
trialEndsAt          TimestampString(3)?
    plan                 Plan                        @relation(fields: [planId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "Subscription_planId_fkey", index: false)
    tenant               Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Subscription_tenantId_fkey")

    @@index([stripeSubscriptionId], map: "Subscription_stripeSubscriptionId_key", unique: true)
    @@index([tenantId], map: "Subscription_tenantId_key", unique: true)
    @@rls
  }

  model TwoFactor {
    id                      String              @id(map: "TwoFactor_pkey") @onCreate(cuid(2))
    userId                  String
    secret                  String
    backupCodes             String
    verified                Boolean             @default(true)
    failedVerificationCount Int                 @default(0)
    lockedUntil             TimestampString(3)?
    createdAt               TimestampString(3)  @default(now())
    // Database default as well as the client-side stamp: Better Auth writes this
    // table through Kysely and its two-factor model sends no timestamps.
    updatedAt               TimestampString(3)  @default(now()) @onUpdate(now())
    user                    User                @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "TwoFactor_userId_fkey")

    @@index([secret], map: "TwoFactor_secret_idx")
    @@index([userId], map: "TwoFactor_userId_idx")
  }

  model Verification {
    id         String             @id(map: "Verification_pkey") @onCreate(cuid(2))
    identifier String
    value      String
    expiresAt  TimestampString(3)
    createdAt  TimestampString(3) @default(now())
    updatedAt  TimestampString(3)  @onCreate(now()) @onUpdate(now())
    @@index([identifier], map: "Verification_identifier_idx")
  }

  // ── platform ──
  // Global settings, one row per key (spec/04-entitlements.md, "Platform
  // switches"). Keys, types, defaults and who may change each live in
  // src/lib/platform-settings.ts; a key with no row reads as its default.
  model PlatformSwitch {
    key         String             @id(map: "PlatformSwitch_pkey")
    value       Json
    updatedById String?
    updatedAt   TimestampString(3) @default(now()) @onUpdate(now())
  }

  // Errors grouped by digest (spec/16-operations.md, ADR 0017). `log.error`
  // writes them in every environment, with a masked message; one row per
  // digest counts the occurrences. Pruned after 30 days by a daily job.
  model ErrorReport {
    id          String              @id(map: "ErrorReport_pkey") @onCreate(uuid(7))
    digest      String
    source      String
    name        String
    message     String
    count       Int                 @default(1)
    requestId   String?
    tenantId    String?
    firstSeenAt TimestampString(3)  @default(now())
    lastSeenAt  TimestampString(3)  @default(now())
    resolvedAt  TimestampString(3)?

    @@index([digest], map: "ErrorReport_digest_key", unique: true)
    @@index([lastSeenAt], map: "ErrorReport_lastSeenAt_idx")
  }

  // Background work (ADR 0008, spec/16-operations.md): one row per run. The
  // cron route claims due rows with FOR UPDATE SKIP LOCKED; a failed run comes
  // back QUEUED with a later runAt until maxAttempts, then stays FAILED.
  model Job {
    id          String              @id(map: "Job_pkey") @onCreate(uuid(7))
    kind        String
    payload     Json                @default(json`{}`)
    status      pg.enum(JobStatus)  @default("QUEUED")
    runAt       TimestampString(3)  @default(now())
    attempts    Int                 @default(0)
    maxAttempts Int                 @default(5)
    lockedUntil TimestampString(3)?
    lastError   String?
    tenantId    String?
    requestId   String?
    createdAt   TimestampString(3)  @default(now())
    updatedAt   TimestampString(3)  @default(now()) @onUpdate(now())
    finishedAt  TimestampString(3)?

    @@index([status, runAt], map: "Job_status_runAt_idx")
    @@index([kind, status], map: "Job_kind_status_idx")
  }

  // The delivery record of every email (spec/16-operations.md, "Email outbox").
  // The row keeps the real recipient, which the log line never does; lastError
  // is masked. Kept a year (spec/10), pruned by a daily job.
  model EmailMessage {
    id                String               @id(map: "EmailMessage_pkey") @onCreate(uuid(7))
    kind              String
    toAddress         String
    subject           String
    provider          String
    status            pg.enum(EmailStatus) @default("QUEUED")
    providerMessageId String?
    lastError         String?
    // The rendered body kept so ops can preview and resend (task 1.13).
    payload           Json?
    tenantId          String?
    createdAt         TimestampString(3)   @default(now())
    updatedAt         TimestampString(3)   @default(now()) @onUpdate(now())
    sentAt            TimestampString(3)?

    @@index([tenantId, createdAt], map: "EmailMessage_tenantId_createdAt_idx")
    @@index([createdAt], map: "EmailMessage_createdAt_idx")
  }

  // Tenancy (spec/02-tenancy.md, ADR 0003, ADR 0019).
  // Better Auth organization plugin tables. The plugin writes through Kysely
  // with these exact column names; model names are mapped in src/auth.ts.
  // Columns it never sends get database defaults, like TwoFactor did.

  model Tenant {
    id               String                @id(map: "Tenant_pkey") @onCreate(cuid(2))
    name             String
    slug             String
    logo             String?
    metadata         Json?
    status           pg.enum(TenantStatus) @default("PROVISIONING")
    graceUntil       TimestampString(3)?
    verticalKey      String                @default("generic")
    connectOnboardingStatus String           @default("not_started")
    payoutsEnabled       Boolean               @default(false)
    timeZone         String                @default("America/Chicago")
    currency         String                @default("usd")
    defaultLanguage  String                @default("en")
    stripeCustomerId String?
    stripeAccountId  String?
    chargesEnabled   Boolean               @default(false)
    createdAt        TimestampString(3)    @default(now())
    updatedAt        TimestampString(3)    @default(now()) @onUpdate(now())
    members          Member[]
    invitations      Invitation[]
    roles            OrganizationRole[]
    settings         TenantSetting[]
    modules          TenantModule[]
    subscribers      NewsletterSubscriber[]
    subscriptions    Subscription[]
    purchases        Purchase[]
    tenantAddOns     TenantAddOn[]
    overrides        EntitlementOverride[]
    usageCounters    UsageCounter[]

    @@index([slug], map: "Tenant_slug_key", unique: true)
    @@index([stripeCustomerId], map: "Tenant_stripeCustomerId_key", unique: true)
    @@index([stripeAccountId], map: "Tenant_stripeAccountId_key", unique: true)
  }

  // Entitlements (spec/04-entitlements.md, spec/09-data-model.md; phase 2).
  // AddOn is the platform catalogue — what a tenant can buy on top of its plan.
  // The catalogue is global; what a tenant holds is tenant-owned.

  model AddOn {
    id            String              @id(map: "AddOn_pkey") @onCreate(cuid(2))
    key           String
    name          String
    features      Json                @default(json`{}`)
    stripePriceId String
    isActive      Boolean             @default(true)
    createdAt     TimestampString(3)  @default(now())
    updatedAt     TimestampString(3)  @default(now()) @onUpdate(now())
    tenantAddOns  TenantAddOn[]
    purchases     Purchase[]

    @@index([key], map: "AddOn_key_key", unique: true)
    @@index([stripePriceId], map: "AddOn_stripePriceId_key", unique: true)
  }

  model TenantAddOn {
    id        String             @id(map: "TenantAddOn_pkey") @onCreate(cuid(2))
    tenantId  String
    addOnId   String
    quantity  Int                @default(1)
    createdAt TimestampString(3) @default(now())
    tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "TenantAddOn_tenantId_fkey")
    addOn     AddOn              @relation(fields: [addOnId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "TenantAddOn_addOnId_fkey")

    @@index([tenantId, addOnId], map: "TenantAddOn_tenantId_addOnId_key", unique: true)
    @@rls
  }

  // A staff override of one feature for one tenant: grant, revoke or change
  // the value, with a reason and an optional expiry (spec/04, "Overrides").
  model EntitlementOverride {
    id            String             @id(map: "EntitlementOverride_pkey") @onCreate(cuid(2))
    tenantId      String
    featureKey    String
    value         Json
    ignoresSwitch Boolean            @default(false)
    reason        String
    expiresAt     TimestampString(3)?
    createdById   String
    createdAt     TimestampString(3) @default(now())
    tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "EntitlementOverride_tenantId_fkey")

    @@index([tenantId, featureKey], map: "EntitlementOverride_tenantId_featureKey_key", unique: true)
    @@rls
  }

  // Metered limits (spec/04): one row per (tenant, limit key, period). The
  // guarded write and the `used` increment share a transaction, with a
  // conditional update so two requests cannot both take the last unit.
  model UsageCounter {
    id          String             @id(map: "UsageCounter_pkey") @onCreate(cuid(2))
    tenantId    String
    limitKey    String
    periodStart TimestampString(3)
    used        Int                @default(0)
    tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "UsageCounter_tenantId_fkey")

    @@index([tenantId, limitKey, periodStart], map: "UsageCounter_tenantId_limitKey_periodStart_key", unique: true)
    @@rls
  }

  // A tenant's own value for a platform setting (display, language); a key
  // without a row falls back to the platform value. Tenant-owned.
  model TenantSetting {
    tenantId    String
    key         String
    value       Json
    updatedById String?
    updatedAt   TimestampString(3) @default(now()) @onUpdate(now())
    tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "TenantSetting_tenantId_fkey")

    @@id([tenantId, key], map: "TenantSetting_pkey")
    @@rls
  }

  // Which modules a tenant has turned on (spec/09-data-model.md,
  // spec/15-module-system.md "Lifecycle"; phase 1, task 1.6). Disabling keeps
  // the row and the module's data; firstEnabledAt records that onEnable ran.
  model TenantModule {
    id             String              @id(map: "TenantModule_pkey") @onCreate(cuid(2))
    tenantId       String
    moduleKey      String
    enabled        Boolean             @default(false)
    settings       Json?
    enabledAt      TimestampString(3)?
    disabledAt     TimestampString(3)?
    firstEnabledAt TimestampString(3)?
    createdAt      TimestampString(3)  @default(now())
    updatedAt      TimestampString(3)  @default(now()) @onUpdate(now())
    tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "TenantModule_tenantId_fkey")

    @@index([tenantId, moduleKey], map: "TenantModule_tenantId_moduleKey_key", unique: true)
    @@rls
  }

  model ModulePurge {
    id         String             @id(map: "ModulePurge_pkey") @onCreate(cuid(2))
    tenantId   String
    moduleKey  String
    status     String             @default("scheduled")
    runAfter   TimestampString(3)
    counts     Json?
    error      String?
    canceledAt TimestampString(3)?
    createdAt  TimestampString(3) @default(now())
    updatedAt  TimestampString(3) @onCreate(now()) @onUpdate(now())
    tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ModulePurge_tenantId_fkey")

    @@index([tenantId, moduleKey], map: "ModulePurge_tenantId_moduleKey_idx")
    @@rls
  }

  model ModuleExport {
    id        String             @id(map: "ModuleExport_pkey") @onCreate(cuid(2))
    tenantId  String
    moduleKey String
    files     Json               @default(json`{}`)
    expiresAt TimestampString(3)
    createdAt TimestampString(3) @default(now())
    tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ModuleExport_tenantId_fkey")

    @@index([tenantId], map: "ModuleExport_tenantId_idx")
    @@rls
  }

  policy_all tenant_module_isolation {
    target    = TenantModule
    using     = sql`"tenantId" = current_setting('app.tenant_id', true)`
    withCheck = sql`"tenantId" = current_setting('app.tenant_id', true)`
  }

  // Tenant isolation (spec/02-tenancy.md, line 2): a row is visible and
  // writable only inside a transaction whose app.tenant_id is its tenant
  // (tenantDb). The owner and the platform role bypass it.
  policy_all tenant_setting_isolation {
    target    = TenantSetting
    using     = sql`"tenantId" = current_setting('app.tenant_id', true)`
    withCheck = sql`"tenantId" = current_setting('app.tenant_id', true)`
  }


