{
  "name": "lessgap-starter-kit",
  "version": "2.91.0",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "imports": {
    "#src/*": "./src/*",
    "#scripts/*": "./scripts/*"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-migration-manifest.mjs",
    "build": "next build",
    "postinstall": "prisma contract emit",
    "start": "next start",
    "lint": "eslint && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "pnpm modules:check && vitest run",
    "check:translations": "vitest run tests/unit/i18n",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "smoke": "node scripts/smoke.mjs",
    "check:deploy": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/check-deploy.mjs",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db-reset.mjs",
    "db:reset:demo": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db-reset.mjs --demo",
    "db:emit": "prisma contract emit",
    "db:plan": "prisma migration plan",
    "db:migrate": "prisma db migrate",
    "db:status": "prisma migration status",
    "db:verify": "prisma db verify",
    "audit:tenancy": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/audit-tenancy.mjs",
    "new:module": "node scripts/new-module.mjs",
    "modules:check": "node scripts/generate-module-registry.mjs && vitest run tests/contract/modules.test.ts",
    "db:roles": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/db-roles.mjs",
    "db:adopt": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db-adopt.mjs"
  },
  "dependencies": {
    "@better-auth/kysely-adapter": "^1.7.14",
    "@hookform/resolvers": "^6.0.1",
    "@js-temporal/polyfill": "^0.5.1",
    "@prisma/orm-extension-pgvector": "8.0.0-rc.21",
    "@prisma/orm-postgres": "8.0.0-rc.20",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@sentry/nextjs": "11.9.0",
    "@stripe/stripe-js": "^10.2.0",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-table": "^9.3.1",
    "@types/pg": "^8.23.1",
    "@vercel/analytics": "^2.0.1",
    "aws4fetch": "1.0.20",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "kysely": "^0.29.7",
    "lucide-react": "^1.62.0",
    "next": "16.4.3",
    "next-intl": "^4.14.9",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "resend": "^6.35.0",
    "sonner": "^2.0.8",
    "stripe": "^23.0.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "uniku": "0.6.0",
    "uqr": "^0.1.3",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.6.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.5",
    "dotenv": "^18.0.9",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "8.0.0-rc.27",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.1",
    "mysql2": "^3.24.3",
    "gray-matter": {
      "js-yaml": {
        "argparse": "^2.0.1"
      }
    }
  }
}
