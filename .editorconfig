# Editor settings every editor understands, with nothing to install.
#
# It states the few mechanical facts a file has, so an editor opening this
# project matches what is already here. Layout, line breaks and quoting belong
# to Prettier (.prettierrc.json, `pnpm format`; spec/adr/0020-application-stack.md).
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown gives trailing spaces a meaning: two of them are a line break.
[*.md]
trim_trailing_whitespace = false
